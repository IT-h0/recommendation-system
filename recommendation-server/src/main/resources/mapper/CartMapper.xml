<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recommendation.server.mapper.CartMapper">

    <resultMap id="BaseResultMap" type="com.recommendation.pojo.entity.CartItem">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="quantity" property="quantity"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM cart_items WHERE user_id = #{userId}
    </select>

    <select id="selectByUserAndProduct" resultMap="BaseResultMap">
        SELECT * FROM cart_items WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.recommendation.pojo.entity.CartItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart_items (user_id, product_id, quantity)
        VALUES (#{userId}, #{productId}, #{quantity})
    </insert>

    <update id="update" parameterType="com.recommendation.pojo.entity.CartItem">
        UPDATE cart_items SET quantity = #{quantity} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM cart_items WHERE id = #{id}
    </delete>

    <delete id="deleteByIdAndUserId">
        DELETE FROM cart_items WHERE id = #{id} AND user_id = #{userId}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM cart_items WHERE user_id = #{userId}
    </delete>

</mapper>

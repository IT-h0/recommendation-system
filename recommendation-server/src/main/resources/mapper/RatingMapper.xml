<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recommendation.server.mapper.RatingMapper">

    <resultMap id="BaseResultMap" type="com.recommendation.pojo.entity.Rating">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="score" property="score"/>
        <result column="comment" property="comment"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <select id="selectByUserAndProduct" resultMap="BaseResultMap">
        SELECT * FROM ratings WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <select id="selectByProductId" resultMap="BaseResultMap">
        SELECT * FROM ratings WHERE product_id = #{productId}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM ratings WHERE user_id = #{userId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM ratings
    </select>

    <insert id="insert" parameterType="com.recommendation.pojo.entity.Rating" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ratings (user_id, product_id, score, comment)
        VALUES (#{userId}, #{productId}, #{score}, #{comment})
    </insert>

    <update id="update" parameterType="com.recommendation.pojo.entity.Rating">
        UPDATE ratings
        <set>
            <if test="score != null">score = #{score},</if>
            <if test="comment != null">comment = #{comment},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>

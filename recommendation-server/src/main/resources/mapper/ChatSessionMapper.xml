<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recommendation.server.mapper.ChatSessionMapper">

    <resultMap id="BaseResultMap" type="com.recommendation.pojo.entity.ChatSession">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM chat_sessions WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM chat_sessions WHERE user_id = #{userId} ORDER BY updated_time DESC
    </select>

    <insert id="insert" parameterType="com.recommendation.pojo.entity.ChatSession" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_sessions (user_id, title, status)
        VALUES (#{userId}, #{title}, #{status})
    </insert>

    <update id="updateTitle">
        UPDATE chat_sessions SET title = #{title}, updated_time = NOW() WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE chat_sessions SET status = #{status}, updated_time = NOW() WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM chat_sessions WHERE id = #{id}
    </delete>

</mapper>

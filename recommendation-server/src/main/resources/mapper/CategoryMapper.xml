<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recommendation.server.mapper.CategoryMapper">

    <resultMap id="BaseResultMap" type="com.recommendation.pojo.entity.Category">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="icon" property="icon"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM categories ORDER BY level, sort_order, id
    </select>

    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT * FROM categories WHERE parent_id = #{parentId} ORDER BY sort_order, id
    </select>

    <select id="selectByLevel" resultMap="BaseResultMap">
        SELECT * FROM categories WHERE level = #{level} ORDER BY sort_order, id
    </select>

</mapper>

<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recommendation.server.mapper.ChatMessageMapper">

    <resultMap id="BaseResultMap" type="com.recommendation.pojo.entity.ChatMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="function_name" property="functionName"/>
        <result column="metadata" property="metadata"/>
        <result column="created_time" property="createdTime"/>
    </resultMap>

    <select id="selectBySessionId" resultMap="BaseResultMap">
        SELECT * FROM chat_messages WHERE session_id = #{sessionId} ORDER BY created_time ASC
    </select>

    <insert id="insert" parameterType="com.recommendation.pojo.entity.ChatMessage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_messages (session_id, role, content, function_name, metadata)
        VALUES (#{sessionId}, #{role}, #{content}, #{functionName}, #{metadata})
    </insert>

</mapper>
